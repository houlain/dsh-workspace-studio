{
  "name": "dsh-workspace-studio",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin: workspace file browser + code viewer + session change diff + hunk-level partial revert (Trae-style). Verified on the desktop app (0.2.1-rc.5) and the Web UI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houlain/dsh-workspace-studio.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "workspace",
    "diff",
    "revert",
    "desktop"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import ./tests/react-stub/register.mjs --test --test-isolation=none \"tests/*.test.ts\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "react": "^18.2.0"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18.3.1"
  },
  "license": "MIT"
}
